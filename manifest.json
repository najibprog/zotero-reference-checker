{
  "manifest_version": 2,
  "name": "Reference Checker",
  "version": "1.3.1",
  "description": "Lists the references of the open article, shows which ones are already in your Zotero library, and opens their PDF in one click.",
  "author": "najibprog",
  "homepage_url": "https://github.com/najibprog/zotero-reference-checker",
  "icons": {
    "48": "content/icons/icon.svg",
    "96": "content/icons/icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-reference-checker@najibprog",
      "update_url": "https://github.com/najibprog/zotero-reference-checker/releases/download/release/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "11.*"
    }
  }
}
